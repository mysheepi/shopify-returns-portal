# Copy to .env and fill in values before running locally.
# On Railway, set these as environment variables in the dashboard.

# PostgreSQL — Railway injects DATABASE_URL automatically when you add the plugin
DATABASE_URL=postgresql://user:password@localhost:5432/returns_portal

# Shopify — rotate your token before deploying (never reuse the one shared in plaintext)
SHOPIFY_STORE=mysheepi
SHOPIFY_TOKEN=shpat_YOUR_NEW_TOKEN_HERE
SHOPIFY_API_VERSION=2024-07

# Portal access password (shared with your team)
PORTAL_PASSWORD=choose_a_strong_password
